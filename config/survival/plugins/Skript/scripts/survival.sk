# 原生 Skript + Vault。变量由 Skript 持久化，重启不会重置已领取奖励。
options:
    prefix: &2[生存服]&r

# 创建前记录召唤者位置，避免出生点插件先把实体挪走而记录错误位置。
command /survivalbotprepare <text> <text>:
    executable by: console
    trigger:
        if arg-2 is "CONSOLE":
            set {survival.bot-location::%arg-1%} to spawn location of world "world"
        else:
            set {_owner} to arg-2 parsed as player
            if {_owner} is set:
                set {survival.bot-location::%arg-1%} to location of {_owner}

# 登录/首次出生插件处理完成再恢复机器旁的位置。
# 只允许控制台调用，必须具有插件真实实体元数据，不能按名字判断。
command /survivalbotrestore <player>:
    executable by: console
    trigger:
        if metadata value "fakeplayer:spawned_at" of arg-1 is not set:
            stop
        set {_bot} to arg-1
        set {_location} to {survival.bot-location::%uuid of {_bot}%}
        if {_location} is not set:
            stop
        wait 3 seconds
        if {_bot} is online:
            teleport {_bot} to {_location}

command /guide [<text>]:
    permission: survival.guide
    executable by: players
    trigger:
        if arg-1 is "claims":
            send "{@prefix} &e金铲右键选择两角圈地，木棍右键查看归属。"
            send "&7/trust 玩家：授权建造；/untrust 玩家：撤销；/claimslist：查看圈地。"
            send "&7/abandonclaim：放弃当前位置圈地；初始 500 格，每小时增加 100 格。"
        else if arg-1 is "compass":
            if metadata value "fakeplayer:spawned_at" of player is set:
                if {survival.bot-location::%uuid of player%} is set:
                    teleport player to {survival.bot-location::%uuid of player%}
                stop
            if player has compass named "&a生存指南针":
                send "{@prefix} &7你已拥有指南针。"
            else:
                give player compass named "&a生存指南针" with lore "&7右键打开服务中心"
        else if arg-1 is "homes":
            send "{@prefix} &e菜单可保存与返回默认“家园”；支持最多三个家。"
            send "{@prefix} &7/sethome 家名：保存当前位置；/home 家名：回家。"
            send "{@prefix} &7/home：查看家列表；/delhome 家名：删除指定家。"
        else if arg-1 is "tpa":
            send "{@prefix} &e输入 /tpa 玩家名，申请前往对方身边。"
            send "{@prefix} &7收到申请可在传送菜单点接受或拒绝；传送等待三秒。"
        else if arg-1 is "chat":
            send "{@prefix} &e/msg 玩家名 内容：私聊；/reply 内容：回复最近联系人。"
        else if arg-1 is "trust":
            send "{@prefix} &e先站在自己的圈地内，输入 /trust 玩家名。"
            send "{@prefix} &7对方可建造、开门和使用容器。离开圈地操作会影响所有圈地。"
            send "{@prefix} &7想只开放箱子或通行，请查看菜单“精细访问权限”。"
        else if arg-1 is "untrust":
            send "{@prefix} &e先站在要调整的圈地内，输入 /untrust 玩家名。"
            send "{@prefix} &7使用 /trustlist 查看现有授权，谨慎使用 /untrust all。"
        else if arg-1 is "claimaccess":
            send "{@prefix} &e先站在要授权的圈地内，再输入以下命令："
            send "{@prefix} &7/accesstrust 玩家名：只允许通行、开门和使用按钮。"
            send "{@prefix} &7/containertrust 玩家名：允许通行及使用箱子等容器。"
            send "{@prefix} &7/permissiontrust 玩家名：允许管理授权，请只给可信好友。"
        else if arg-1 is "wallet":
            send "{@prefix} &e输入 /balance 查看金币；/pay 玩家名 金额 转账。"
            send "{@prefix} &7主城与生存共用钱包，创造世界禁止交易。"
        else if arg-1 is "password":
            send "{@prefix} &e/changepassword 旧密码 新密码：修改服内登录密码。"
            send "{@prefix} &7在聊天命令中填写，不要发送普通聊天消息或公开密码。"
        else if arg-1 is "fishing":
            send "{@prefix} &b新增 54 种奖励条目：海边拾遗、深海馈赠、海底珍藏。"
            send "{@prefix} &7包含海洋材料、装饰、附魔书、钓竿、唱片与少量珍贵资源。"
            send "{@prefix} &7额外奖励要求开放水域；优先选择自然湖泊或海边。"
            send "{@prefix} &7稀有 / 史诗基础概率为 百分之二 / 千分之五，对应能力会提高概率。"
            send "{@prefix} &7珍藏池基础概率 万分之八，不增加幸运倍率；不额外发金币。"
        else if arg-1 is "market":
            send "{@prefix} &e放置箱子，手持商品左键箱子，再按提示在聊天中输入价格。"
            send "&7把货物放进箱子供他人购买；空箱不能凭空出售。"
            send "&7看着自己的店铺输入 /qs buy 改为收购，/qs sell 改为出售。"
            send "&7/qs price 金额：改价；/qs remove：移除自己的店铺；/qs browse：浏览。"
            send "&7只有生存维度开放交易，每人最多 20 家；建议在自己的领地内开店。"
        else if arg-1 is "dh":
            send "{@prefix} &b本服支持遥远地平线，Java 26.2 使用 Distant Horizons 3.2.0-b。"
            send "&7当前官方服务端支持 3.1/3.2 协议；3.3 版本暂不保证互通。"
            send "&7客户端需要 Fabric 或 NeoForge 及对应 MOD；PE 无法使用该效果。"
            send "&7上限 128 区块，仅处理已生成地形，不提高生物活动或模拟距离。"
        else if arg-1 is "worldedit":
            send "{@prefix} &e创世神 WorldEdit 已安装，仅管理员可用。"
            send "&7//wand：选区工具；//copy 与 //paste：复制粘贴；//undo：撤销。"
            send "&7请分批操作并事先备份，不要给普通玩家 WorldEdit 通配权限。"
        else if arg-1 is "technical":
            send "{@prefix} &e/fp spawn：在当前位置创建假人；每人限一个。"
            send "&7/fp attack continuous：持续攻击；/fp use continuous：持续使用。"
            send "&7/fp stop：停止动作；/fp invsee：假人背包；/fp kick：移除。"
            send "&7仅生存维度使用，离线 15 秒后移除，背包保存；假人不领取金币或技能经验。"
        else if arg-1 is "linking":
            send "{@prefix} &e先在 Java 主账号注册并登录，输入 /linkaccount 查看本地绑定步骤。"
            send "&7在 PE 账号登录后按提示完成验证，再重新连接并使用 Java 账号密码。"
            send "&7绑定后共用 Java 进度，不自动合并旧 PE 背包；绑定前先转移物品。"
            send "&7同一账号不能双端同时在线；/unlinkaccount 解除绑定。"
        else if arg-1 is "fun":
            send "{@prefix} &e空手右键台阶、半砖或地毯坐下，潜行站起。"
            send "&7空手右键玩家骑到头顶，最多叠 3 人；底下玩家潜行可甩下乘客。"
            send "&7/sit playertoggle：允许/拒绝被骑乘；/sit toggle：开关点击坐下。"
            send "&7/lay：躺下；/crawl：爬行；/spin：转圈；/fun：互动菜单。"
        else:
            send "{@prefix} &a欢迎来到原版生存！"
            send "&7/menu：玩家中心；/guide compass：领取菜单指南针。"
            send "&7/worlds：选择世界；/hub：返回主城；/fun：趣味互动。"
            send "&7主城与生存共用背包；创造世界隔离，物品不能带回生存。"
            send "&7/sethome 家名：设家；/home 家名：回家；/delhome 家名：删除。"
            send "&7/tpa 玩家：申请传送；/tpaccept：接受；/tpdeny：拒绝。"
            send "&7/shop：物资商店；/balance：余额；/pay 玩家 金额：转账。"
            send "&7/reward：领取在线奖励；/guide claims：圈地说明。"
            send "&7/msg 玩家 内容：私聊；/spawn：出生点；/changepassword：改密。"

on right click:
    if player's tool is compass named "&a生存指南针":
        cancel event
        make player execute command "menu"

on join:
    set {survival.last-location::%uuid of player%} to location of player

on world change:
    wait 1 second
    if player is online:
        set {survival.last-location::%uuid of player%} to location of player
        if player does not have compass named "&a生存指南针":
            give player compass named "&a生存指南针" with lore "&7右键打开服务中心"

on quit:
    delete {survival.last-location::%uuid of player%}
    delete {survival.bot-location::%uuid of player%}

command /hub:
    permission: survival.guide
    executable by: players
    trigger:
        make player execute command "mv tp w:lobby"

# 同时覆盖 /home、/tpa 等插件造成的跨世界传送，不携带载具或骑乘玩家。
on teleport:
    if world of past event-location is not world of future event-location:
        eject passengers of player
        make player dismount

every 2 seconds:
    loop all players:
        if name of world of loop-player is "lobby":
            if y-coordinate of loop-player's location is less than -20:
                teleport loop-player to spawn of world "lobby"

every 1 minute:
    set {_day} to now formatted as "yyyy-MM-dd"
    loop all players:
        if metadata value "fakeplayer:spawned_at" of loop-player is set:
            continue
        if gamemode of loop-player is creative:
            continue
        set {_id} to uuid of loop-player
        if {survival.day::%{_id}%} is not {_day}:
            set {survival.day::%{_id}%} to {_day}
            set {survival.minutes::%{_id}%} to 0
            delete {survival.claimed::%{_id}%::*}
        if {survival.last-location::%{_id}%} is set:
            if world of loop-player is world of {survival.last-location::%{_id}%}:
                if distance between location of loop-player and {survival.last-location::%{_id}%} is greater than 1:
                    add 1 to {survival.minutes::%{_id}%}
        set {survival.last-location::%{_id}%} to location of loop-player

command /reward:
    permission: survival.reward
    executable by: players
    trigger:
        if metadata value "fakeplayer:spawned_at" of player is set:
            stop
        if gamemode of player is creative:
            send "{@prefix} &c请先回生存或主城领取奖励。"
            stop
        set {_id} to uuid of player
        set {_day} to now formatted as "yyyy-MM-dd"
        if {survival.day::%{_id}%} is not {_day}:
            set {survival.day::%{_id}%} to {_day}
            set {survival.minutes::%{_id}%} to 0
            delete {survival.claimed::%{_id}%::*}
        set {_minutes} to {survival.minutes::%{_id}%}
        set {_paid} to 0
        loop 30, 60 and 120:
            if {_minutes} is greater than or equal to loop-value:
                if {survival.claimed::%{_id}%::%loop-value%} is not true:
                    set {survival.claimed::%{_id}%::%loop-value%} to true
                    if loop-value is 30:
                        add 50 to player's balance
                        add 50 to {_paid}
                    else if loop-value is 60:
                        add 100 to player's balance
                        add 100 to {_paid}
                    else:
                        add 200 to player's balance
                        add 200 to {_paid}
        send "{@prefix} &e今日活跃在线：%{_minutes}% 分钟，本次领取：%{_paid}% 金币。"
        send "&7每天 30 / 60 / 120 分钟奖励 50 / 100 / 200 金币；每分钟检测位移。"
